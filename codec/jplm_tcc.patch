diff --git a/source/Lib/Part2/Common/TransformMode/Padding.cpp b/source/Lib/Part2/Common/TransformMode/Padding.cpp
new file mode 100644
index 00000000..8df07278
--- /dev/null
+++ b/source/Lib/Part2/Common/TransformMode/Padding.cpp
@@ -0,0 +1,1174 @@
+#include "Padding.h"
+#include <array>
+#include <cmath>
+#include <iostream>
+#include <mutex>
+
+DCT4DCoefficientsManager& PaddingManager::manager(DCT4DCoefficientsManager::get_instance(true));
+DCT4DCoefficientsManager& PaddingManager::inverse_manager(DCT4DCoefficientsManager::get_instance(false));
+
+bool PaddingManager::use_order = true;
+bool PaddingManager::use_composite = false;
+bool PaddingManager::enabled = false;
+
+void PaddingManager::transform(double *src, double *dstn, std::size_t size, double weight, std::size_t stride, bool forward) {
+    if (forward) {
+        if (use_order && use_composite) do_padding_composite(src, dstn, size, weight, stride);
+        else if (use_order) do_padding(src, dstn, size, weight, stride);
+        else do_padding_without_order(src, dstn, size, weight, stride);
+    } else {
+        undo_padding(src, dstn, size, weight, stride);
+    }
+}
+
+const PaddingManager::CompositeMatrices& PaddingManager::composite_matrices(std::size_t size) {
+    static std::vector<CompositeMatrices> table(33);
+    static std::once_flag computed;
+    std::call_once(computed, []() {
+        double worst_round_trip = 0.0;
+        for (std::size_t k = 2; k < 32; ++k) {
+            std::size_t n = next_power_of_2(k);
+            if (n == k || order_look_up_table[k - 1] == nullptr) continue;
+            const unsigned int* order = order_look_up_table[k - 1];
+            std::vector<std::size_t> valid;
+            std::size_t padding_index = 0;
+            for (std::size_t i = 0; i < n; ++i) {
+                if (padding_index < n - k && i == order[padding_index]) ++padding_index;
+                else valid.push_back(i);
+            }
+            CompositeMatrices& m = table[k];
+            m.forward.resize(k * k);
+            const double* t = composite_look_up_table[k - 1];
+            const double scale = std::sqrt(static_cast<double>(n));
+            for (std::size_t i = 0; i < k * k; ++i) m.forward[i] = scale * t[i];
+            const double* idct = inverse_manager.get_coefficients_for_size(n);
+            for (std::size_t r = 0; r < k; ++r)
+                for (std::size_t j = 0; j < k; ++j) {
+                    double s = 0.0;
+                    for (std::size_t l = 0; l < k; ++l) s += idct[valid[r] * n + l] * m.forward[l * k + j];
+                    worst_round_trip = std::max(worst_round_trip, std::fabs(s - (r == j ? 1.0 : 0.0)));
+                }
+        }
+        std::cerr << "Shen padding: composite form (tabulated T), max|D.T - I| = " << worst_round_trip << std::endl;
+    });
+    return table[size];
+}
+
+const std::vector<double>& PaddingManager::unordered_padding_matrix(std::size_t size) {
+    static std::vector<std::vector<double>> table(33);
+    static std::once_flag computed;
+    std::call_once(computed, []() {
+        for (std::size_t k = 2; k < 32; ++k) {
+            std::size_t n = next_power_of_2(k);
+            if (n == k) continue;
+            std::size_t m = n - k;
+            const double* c = manager.get_coefficients_for_size(n);
+            std::vector<long double> a(m * m), b(m * k);
+            for (std::size_t r = 0; r < m; ++r) {
+                for (std::size_t j = 0; j < m; ++j) a[r * m + j] = c[(k + r) * n + (k + j)];
+                for (std::size_t j = 0; j < k; ++j) b[r * k + j] = -c[(k + r) * n + j];
+            }
+            for (std::size_t col = 0; col < m; ++col) {
+                std::size_t piv = col;
+                for (std::size_t r = col + 1; r < m; ++r)
+                    if (std::fabs((double) a[r * m + col]) > std::fabs((double) a[piv * m + col])) piv = r;
+                for (std::size_t j = 0; j < m; ++j) std::swap(a[col * m + j], a[piv * m + j]);
+                for (std::size_t j = 0; j < k; ++j) std::swap(b[col * k + j], b[piv * k + j]);
+                for (std::size_t r = 0; r < m; ++r) {
+                    if (r == col) continue;
+                    long double f = a[r * m + col] / a[col * m + col];
+                    for (std::size_t j = 0; j < m; ++j) a[r * m + j] -= f * a[col * m + j];
+                    for (std::size_t j = 0; j < k; ++j) b[r * k + j] -= f * b[col * k + j];
+                }
+            }
+            table[k].resize(m * k);
+            double max_abs = 0.0;
+            for (std::size_t r = 0; r < m; ++r)
+                for (std::size_t j = 0; j < k; ++j) {
+                    table[k][r * k + j] = (double) (b[r * k + j] / a[r * m + r]);
+                    max_abs = std::max(max_abs, std::fabs(table[k][r * k + j]));
+                }
+            std::cerr << "Shen padding without interlacing: N=" << n << " K=" << k << " max|P|=" << max_abs << std::endl;
+        }
+    });
+    return table[size];
+}
+
+inline std::size_t PaddingManager::next_power_of_2(std::size_t n){
+    n -= 1;
+    n |= n >> 1;
+    n |= n >> 2;
+    n |= n >> 4;
+    n |= n >> 8;  
+    n |= n >> 16;
+    // n |= n >> 32; 
+    return n + 1;
+}
+
+void PaddingManager::do_padding(double *src, double *dstn, std::size_t size, double weight, std::size_t stride) {
+    if(size == 1){
+        *dstn = 2 * (*src);
+        return;
+    }
+
+    const double* coefficients = coefficients_look_up_table[size - 1];
+    const unsigned int* order = order_look_up_table[size - 1];
+
+    std::size_t n = next_power_of_2(size);
+    double padding_values[n - size];
+    double tmp[n];
+
+    for (int i = 0; i < n - size; ++i) {
+        padding_values[i] = std::inner_product(src, src + size, coefficients + (i * size), 0.0);
+    }
+        
+    int padding_count = 0;
+    for(int i = 0; i < n; ++i) {
+        if(padding_count < n - size && i == order[padding_count]) {
+            tmp[i] = padding_values[padding_count++];
+        } else {
+            tmp[i] = *(src + i - padding_count);
+        }
+    }
+
+    const double *coeff_ptr = manager.get_coefficients_for_size(n);
+    double* tmp_end = tmp + n;
+
+    for (int i = 0; i < size; ++i) {
+        *dstn =  weight * std::inner_product(tmp, tmp_end, coeff_ptr, 0.0);
+        coeff_ptr += n;
+        dstn += stride;
+    }
+}
+
+
+void PaddingManager::undo_padding(double *src, double *dstn, std::size_t size, double weight, std::size_t stride) {
+    static const std::array<const double*, 33> idct_of_size = [] {
+        std::array<const double*, 33> t{};
+        for (std::size_t n : {4, 8, 16, 32}) t[n] = inverse_manager.get_coefficients_for_size(n);
+        return t;
+    }();
+    const std::size_t n = next_power_of_2(size);
+    const double* idct = idct_of_size[n];
+    const unsigned int* order = order_look_up_table[size - 1];
+    std::size_t padding_index = 0;
+    for (std::size_t i = 0; i < n; ++i) {
+        const bool padded = use_order ? (padding_index < n - size && i == order[padding_index]) : (i >= size);
+        if (padded) {
+            if (use_order) ++padding_index;
+            continue;
+        }
+        *dstn = weight * std::inner_product(src, src + size, idct + i * n, 0.0);
+        dstn += stride;
+    }
+}
+
+void PaddingManager::do_padding_without_order(double *src, double *dstn, std::size_t size, double weight, std::size_t stride) {
+    if(size == 1){
+        *dstn = 2 * (*src);
+        return;
+    }
+
+    const std::vector<double>& coefficients = unordered_padding_matrix(size);
+
+    std::size_t n = next_power_of_2(size);
+    double padding_values[n - size];
+    double tmp[n];
+
+    for (std::size_t i = 0; i < n - size; ++i) {
+        padding_values[i] = std::inner_product(src, src + size, coefficients.data() + (i * size), 0.0);
+    }
+
+    for(std::size_t i = 0; i < size; ++i) {
+        tmp[i] = src[i];
+    }
+
+    for(std::size_t i = size; i < n; ++i) {
+        tmp[i] = padding_values[i - size];
+    }
+
+    const double *coeff_ptr = manager.get_coefficients_for_size(n);
+    double* tmp_end = tmp + n;
+
+    for (std::size_t i = 0; i < size; ++i) {
+        *dstn =  weight * std::inner_product(tmp, tmp_end, coeff_ptr, 0.0);
+        coeff_ptr += n;
+        dstn += stride;
+    }
+}
+
